{
  "cleanUrls": true,
  "redirects": [
    { "source": "/download", "destination": "https://github.com/payamrajabi/aloud-releases/releases/latest/download/Aloud.dmg", "permanent": false },
    { "source": "/releases/:tag/:file", "destination": "https://github.com/payamrajabi/aloud-releases/releases/download/:tag/:file", "permanent": false }
  ],
  "rewrites": [
    { "source": "/buy", "destination": "/api/buy" }
  ],
  "headers": [
    { "source": "/appcast.xml", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] },
    { "source": "/(thanks|activate|restore)", "headers": [{ "key": "Cache-Control", "value": "no-store" }, { "key": "Referrer-Policy", "value": "no-referrer" }] }
  ]
}
