{
  "name": "Aloud sandbox license recovery",
  "description": "Inactive proposal: POST restore on the sandbox hostname only, 5 requests per IP per 600-second regional window. Requires approval and verification before use.",
  "active": false,
  "conditionGroup": [
    {
      "conditions": [
        { "type": "host", "op": "eq", "value": "payments-test.aloudformac.com" },
        { "type": "path", "op": "eq", "value": "/api/restore" },
        { "type": "method", "op": "eq", "value": "POST" }
      ]
    }
  ],
  "action": {
    "mitigate": {
      "action": "rate_limit",
      "rateLimit": {
        "algo": "fixed_window",
        "window": 600,
        "limit": 5,
        "keys": ["ip"],
        "action": "rate_limit"
      }
    }
  }
}
